# Optional configuration for docker-compose.
# Copy to .env and adjust: cp .env.example .env
# Every variable has a default in docker-compose.yml, so .env is not required.

# Host ports
API_PORT=8080
LOCALSTACK_PORT=4566

# AWS settings. LocalStack accepts any credentials: these are NOT real secrets.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB single table used by the API
DYNAMODB_TABLE_NAME=franchises
