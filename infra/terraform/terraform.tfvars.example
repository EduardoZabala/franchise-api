# Copy to terraform.tfvars and adjust. Every value has a default in variables.tf.

aws_region           = "us-east-1"
github_repository    = "EduardoZabala/franchise-api"
allowed_ingress_cidr = "0.0.0.0/0" # better: "<your-public-ip>/32"
desired_count        = 1

# Set to false if your AWS account already has the GitHub OIDC provider
create_github_oidc_provider = true
